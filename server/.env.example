# ==============================================================
# RentWise Server Environment Configuration
# ==============================================================

# --------------------------------------------------------------
# LOCAL DEVELOPMENT (server/.env)
# --------------------------------------------------------------
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
JWT_SECRET=rentwise-dev-super-secret-key-change-in-production-2026
JWT_EXPIRES_IN=24h
DATABASE_URL="mysql://username:password@localhost:3306/rentwise_db"

# Dedicated Test Database (Used by Vitest to isolate automated tests and protect rentwise_db)
TEST_DATABASE_URL="mysql://username:password@localhost:3306/rentwise_test_db"

# Optional: Set to true only if you explicitly permit tests to wipe the local development database
# ALLOW_DEV_DB_RESET=false

# --------------------------------------------------------------
# PRODUCTION (Vercel Project Settings > Environment Variables)
# --------------------------------------------------------------
# NODE_ENV=production
# CLIENT_URL=https://your-rentwise-frontend.vercel.app
# JWT_SECRET=generate-a-strong-random-64-character-hex-string
# JWT_EXPIRES_IN=24h
#
# Hosted MySQL Connection String (TiDB Cloud, Aiven, Railway, AWS RDS):
# Append ?sslaccept=strict&connection_limit=5&connect_timeout=15 to enable SSL and avoid connection pool exhaustion in serverless environments.
# Example:
# DATABASE_URL="mysql://username:password@gateway.provider.com:4000/rentwise?sslaccept=strict&connection_limit=5&connect_timeout=15"
